{
  "name": "@knowscroll/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free backend modules and infrastructure adapters used by the API and worker applications.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./erasure-registry": {
      "@knowscroll/source": "./src/erasure-registry.ts",
      "types": "./dist/erasure-registry.d.ts",
      "default": "./dist/erasure-registry.js"
    },
    "./infrastructure/config": {
      "@knowscroll/source": "./src/infrastructure/config/index.ts",
      "types": "./dist/infrastructure/config/index.d.ts",
      "default": "./dist/infrastructure/config/index.js"
    },
    "./infrastructure/erasure": {
      "@knowscroll/source": "./src/infrastructure/erasure/index.ts",
      "types": "./dist/infrastructure/erasure/index.d.ts",
      "default": "./dist/infrastructure/erasure/index.js"
    },
    "./infrastructure/ids": {
      "@knowscroll/source": "./src/infrastructure/ids/index.ts",
      "types": "./dist/infrastructure/ids/index.d.ts",
      "default": "./dist/infrastructure/ids/index.js"
    },
    "./infrastructure/jobs": {
      "@knowscroll/source": "./src/infrastructure/jobs/index.ts",
      "types": "./dist/infrastructure/jobs/index.d.ts",
      "default": "./dist/infrastructure/jobs/index.js"
    },
    "./infrastructure/lifecycle": {
      "@knowscroll/source": "./src/infrastructure/lifecycle/index.ts",
      "types": "./dist/infrastructure/lifecycle/index.d.ts",
      "default": "./dist/infrastructure/lifecycle/index.js"
    },
    "./infrastructure/notices": {
      "@knowscroll/source": "./src/infrastructure/notices/index.ts",
      "types": "./dist/infrastructure/notices/index.d.ts",
      "default": "./dist/infrastructure/notices/index.js"
    },
    "./infrastructure/observability": {
      "@knowscroll/source": "./src/infrastructure/observability/index.ts",
      "types": "./dist/infrastructure/observability/index.d.ts",
      "default": "./dist/infrastructure/observability/index.js"
    },
    "./infrastructure/postgres": {
      "@knowscroll/source": "./src/infrastructure/postgres/index.ts",
      "types": "./dist/infrastructure/postgres/index.d.ts",
      "default": "./dist/infrastructure/postgres/index.js"
    },
    "./infrastructure/receipts": {
      "@knowscroll/source": "./src/infrastructure/receipts/index.ts",
      "types": "./dist/infrastructure/receipts/index.d.ts",
      "default": "./dist/infrastructure/receipts/index.js"
    },
    "./modules/content": {
      "@knowscroll/source": "./src/modules/content/public.ts",
      "types": "./dist/modules/content/public.d.ts",
      "default": "./dist/modules/content/public.js"
    },
    "./modules/evidence": {
      "@knowscroll/source": "./src/modules/evidence/public.ts",
      "types": "./dist/modules/evidence/public.d.ts",
      "default": "./dist/modules/evidence/public.js"
    },
    "./modules/evidence/nest-providers": {
      "@knowscroll/source": "./src/modules/evidence/adapters/nest-providers.ts",
      "types": "./dist/modules/evidence/adapters/nest-providers.d.ts",
      "default": "./dist/modules/evidence/adapters/nest-providers.js"
    },
    "./modules/experience": {
      "@knowscroll/source": "./src/modules/experience/public.ts",
      "types": "./dist/modules/experience/public.d.ts",
      "default": "./dist/modules/experience/public.js"
    },
    "./modules/experience/nest-providers": {
      "@knowscroll/source": "./src/modules/experience/adapters/nest-providers.ts",
      "types": "./dist/modules/experience/adapters/nest-providers.d.ts",
      "default": "./dist/modules/experience/adapters/nest-providers.js"
    },
    "./modules/identity": {
      "@knowscroll/source": "./src/modules/identity/public.ts",
      "types": "./dist/modules/identity/public.d.ts",
      "default": "./dist/modules/identity/public.js"
    },
    "./reasoning": {
      "@knowscroll/source": "./src/reasoning/public.ts",
      "types": "./dist/reasoning/public.d.ts",
      "default": "./dist/reasoning/public.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:types": "kysely-codegen --config-file kysely-codegen.json",
    "db:types:verify": "kysely-codegen --config-file kysely-codegen.json --verify"
  },
  "dependencies": {
    "kysely": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kysely-codegen": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
