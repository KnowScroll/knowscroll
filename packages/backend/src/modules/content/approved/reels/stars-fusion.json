    "worldId": "knowscroll-stars-fusion",
    "narration": [
      {
        "text": "A star glows steadily in the dark of space.",
        "claimIds": ["c1"]
      },
      {
        "text": "Gravity is always squeezing it inward.",
        "claimIds": ["c1"]
      },
      {
        "text": "Deep in its core, hydrogen joins to make helium and releases energy.",
        "claimIds": ["c2"]
      },
      {
        "text": "That energy pushes outward and balances the squeeze.",
        "claimIds": ["c2"]
      },
      {
        "text": "A heavier star burns its fuel faster and shines for a shorter time.",
        "claimIds": ["c3"]
      },
      {
        "text": "A lighter star burns slowly and shines for far longer.",
        "claimIds": ["c4"]
      }
    ],
