    "worldId": "knowscroll-black-hole-horizon",
    "narration": [
      {
        "text": "A black hole is a dark sphere hanging in empty space.",
        "claimIds": ["c1"]
      },
      {
        "text": "Its edge is a one-way boundary, not a solid wall.",
        "claimIds": ["c1"]
      },
      {
        "text": "Hot gas circling outside it glows brightly.",
        "claimIds": ["c2"]
      },
      {
        "text": "Its gravity bends that light into a bright ring around a dark shadow.",
        "claimIds": ["c2"]
      },
      {
        "text": "Gravity pulls hardest on the nearest side of anything falling in.",
        "claimIds": ["c3"]
      },
      {
        "text": "A falling object is drawn out long and thin.",
        "claimIds": ["c3"]
      }
    ],
