  "recipe": "tides-spring-neap",
  "brief": {
    "version": 1,
    "worldId": "knowscroll-tides-spring-neap",
    "narration": [
      {
        "text": "At low water, a wide sandy beach lies bare.",
        "claimIds": ["c1"]
      },
      {
        "text": "At high water, the sea covers most of the same beach.",
        "claimIds": ["c2"]
      },
      {
        "text": "Near a full Moon, high water climbs higher and low water falls lower.",
        "claimIds": ["c3"]
      },
      {
        "text": "These bigger swings are called spring tides, and they happen in every season.",
        "claimIds": ["c3"]
      },
      {
        "text": "Near a half Moon, the Moon and Sun pull from different angles.",
        "claimIds": ["c4"]
      },
      {
        "text": "Then high water is a little lower, low water a little higher, and the range is smaller.",
        "claimIds": ["c4"]
      }
    ],
