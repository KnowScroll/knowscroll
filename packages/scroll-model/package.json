{
  "name": "@knowscroll/scroll-model",
  "version": "0.0.0",
  "private": true,
  "description": "The canonical declarative Scroll document (scroll-document.v1): schemas, limits, validation, negotiation, locators, block state and simulation evaluation, plus the backend-only producer contract and internal provenance.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@knowscroll/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./producer": {
      "@knowscroll/source": "./src/producer/index.ts",
      "types": "./dist/producer/index.d.ts",
      "default": "./dist/producer/index.js"
    },
    "./internal": {
      "@knowscroll/source": "./src/internal/index.ts",
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./fixtures/*.json": "./fixtures/documents/*.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fixtures": "tsc -p tsconfig.build.json && node fixtures/regenerate.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
