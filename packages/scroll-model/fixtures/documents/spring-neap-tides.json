          "a11y": {
            "label": "Tides through one lunar month"
          },
          "fallbackText": "Text version: spring tides come at the new and full Moon; neap tides come at the first and last quarter.",
          "essential": false,
          "gesture": "none",
          "data": {
            "title": "One lunar month",
            "events": [
              {
                "id": "new-moon",
                "when": "New Moon",
                "title": "Spring tides",
                "detail": [
                  {
                    "text": "Sun and Moon on the same side of Earth."
                  }
                ]
              },
              {
                "id": "first-quarter",
                "when": "First quarter",
                "title": "Neap tides"
              },
              {
                "id": "full-moon",
                "when": "Full Moon",
                "title": "Spring tides",
                "detail": [
                  {
                    "text": "Sun and Moon on opposite sides, still in a line."
                  }
                ]
              },
              {
                "id": "last-quarter",
                "when": "Last quarter",
                "title": "Neap tides"
              }
            ]
          }
        },
        {
          "id": "coasts-callout",
          "type": "callout",
          "version": 1,
          "a11y": {
            "label": "Limits"
          },
          "essential": false,
          "gesture": "none",
          "data": {
            "kind": "limit",
            "spans": [
              {
                "text": "Coastline shape, ocean depth, wind and storms bend the real pattern away from this picture, so a local tide table matters more than the Moon alone."
              }
            ]
          }
        }
