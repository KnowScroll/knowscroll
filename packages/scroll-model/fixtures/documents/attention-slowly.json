  "kicker": "Machine learning",
  "title": "Attention, slowly",
  "dek": "The same idea as the Reel, with room to try it yourself.",
  "framing": {
    "kind": "factual"
  },
  "sections": [
    {
      "id": "crowd",
      "heading": null,
      "blocks": [
        {
          "id": "crowd-p1",
          "type": "paragraph",
          "version": 1,
          "a11y": {
            "label": "Paragraph"
          },
          "essential": false,
          "gesture": "none",
          "data": {
            "spans": [
              {
                "text": "Read this: "
              },
              {
                "text": "the animal didn’t cross the street because it was too tired.",
                "marks": ["em"]
              },
              {
                "text": " You knew at once that “it” meant the animal, not the street."
              }
            ]
          }
        },
        {
          "id": "crowd-p2",
          "type": "paragraph",
          "version": 1,
          "a11y": {
            "label": "Paragraph"
          },
          "essential": false,
          "gesture": "none",
          "data": {
            "spans": [
              {
                "text": "A language model has to work that out too. In a step called attention, every word looks at every other word and asks how much each one matters to it."
              }
            ]
          }
        },
        {
          "id": "it-diagram",
          "type": "diagram",
          "version": 1,
          "a11y": {
            "label": "Where “it” looks",
            "description": "The word “it” is linked to animal, street, tired and cross. Line thickness shows how much attention “it” pays to each word."
          },
          "fallbackText": "Text version: in “because it was too tired”, the word “it” pays most attention to animal and some to tired. Change the ending to “too wide” and most attention moves to street.",
          "essential": true,
          "gesture": "two-axis",
          "data": {
            "title": "Where “it” looks",
            "instruction": "Drag “it” onto the word you think it means",
            "layout": "radial",
            "nodes": [
              {
                "id": "it",
