                ]
              },
              {
                "id": "means-street",
                "label": "…because it was too wide",
                "description": "Change one word to “too wide” and “it” now points mostly at street: the ending decides what “it” means.",
                "emphasis": ["street", "wide", "e-street"],
                "hidden": ["tired", "e-tired"],
                "weights": [
                  {
