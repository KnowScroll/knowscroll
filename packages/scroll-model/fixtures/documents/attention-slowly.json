            "groups": [],
            "frames": [
              {
                "id": "means-animal",
                "label": "…because it was too tired",
                "description": "With “too tired”, “it” pays most attention to animal, some to tired, and very little to street or cross.",
                "emphasis": ["animal", "tired", "e-animal"],
                "hidden": ["wide", "e-wide"],
                "weights": [
                  {
                    "edge": "e-animal",
                    "weight": 0.8
