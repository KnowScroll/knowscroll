{
  "draftVersion": "scroll-draft.v1",
  "title": "How heavy would you be on other worlds?",
  "dek": "Put in your weight and see what a bathroom scale would read.",
  "sections": [
    {
      "id": "scales",
      "heading": null,
      "blocks": [
        {
          "id": "weight-sim",
          "type": "simulation",
          "essential": true,
          "a11y": {
            "label": "Your weight on four worlds",
            "description": "Enter your weight on Earth; four cards show what a scale would read on the Moon, Mars, Earth and Jupiter."
          },
          "fallbackText": "Text version: a scale reads your Earth weight times the world’s gravity. Someone who weighs 60 kg on Earth would read about 10 kg on the Moon, 23 kg on Mars and 152 kg at Jupiter’s cloud tops.",
          "data": {
            "title": "Your weight on other worlds",
            "params": [
              {
                "key": "weightKg",
                "label": "Your weight on Earth",
                "unit": "kg",
                "min": 20,
                "max": 200,
                "step": 1,
                "default": 60,
                "control": "input",
                "format": {
                  "decimals": 0,
                  "grouping": false,
                  "approximate": false
                },
                "personal": true
              }
            ],
            "constants": [
              {
                "key": "gMoon",
                "label": "Moon gravity compared with Earth",
                "value": 0.165
              },
              {
                "key": "gMars",
                "label": "Mars gravity compared with Earth",
                "value": 0.38
              },
              {
                "key": "gJupiter",
                "label": "Jupiter gravity compared with Earth",
                "value": 2.53
              }
            ],
            "outputs": [
              {
                "key": "moonKg",
                "label": "On the Moon",
                "unit": "kg",
                "formula": {
                  "kind": "product",
                  "factors": ["weightKg", "gMoon"]
                },
                "format": {
                  "decimals": 0,
                  "grouping": false,
                  "approximate": false
                }
              },
              {
                "key": "marsKg",
                "label": "On Mars",
                "unit": "kg",
                "formula": {
                  "kind": "product",
                  "factors": ["weightKg", "gMars"]
                },
                "format": {
                  "decimals": 0,
                  "grouping": false,
                  "approximate": false
                }
              },
              {
                "key": "earthKg",
                "label": "On Earth",
                "unit": "kg",
                "formula": {
                  "kind": "product",
                  "factors": ["weightKg", 1]
                },
                "format": {
                  "decimals": 0,
                  "grouping": false,
                  "approximate": false
                }
              },
              {
                "key": "jupiterKg",
                "label": "At Jupiter’s cloud tops",
                "unit": "kg",
                "formula": {
                  "kind": "product",
                  "factors": ["weightKg", "gJupiter"]
                },
                "format": {
                  "decimals": 0,
                  "grouping": false,
                  "approximate": false
                }
              }
            ],
            "view": {
              "kind": "cards",
              "barMax": 510,
              "items": [
                {
                  "id": "moon",
                  "label": "Moon",
                  "output": "moonKg"
                },
                {
                  "id": "mars",
                  "label": "Mars",
                  "output": "marsKg"
                },
                {
                  "id": "earth",
                  "label": "Earth",
                  "output": "earthKg"
                },
                {
                  "id": "jupiter",
                  "label": "Jupiter",
                  "output": "jupiterKg",
                  "note": "Jupiter has no ground to stand on; this is at its cloud tops."
                }
              ]
            },
            "modelNote": "Scale reading = your Earth weight × the world’s surface gravity compared with Earth, rounded to the nearest kilogram.",
            "illustrative": false
          }
        },
        {
          "id": "scales-p1",
          "type": "paragraph",
          "data": {
            "spans": [
              {
                "text": "What changes is "
              },
              {
                "text": "surface gravity",
                "marks": ["strong"]
              },
              {
                "text": ": how hard each world pulls on you. You are made of the same stuff everywhere; the scale just feels a different pull."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pull",
      "heading": "How hard each world pulls",
      "blocks": [
        {
          "id": "gravity-chart",
          "type": "chart",
          "a11y": {
            "label": "Surface gravity compared with Earth"
          },
          "fallbackText": "Surface gravity compared with Earth: Moon about 0.17, Mars about 0.38, Earth 1, Jupiter about 2.53 at its cloud tops.",
          "data": {
            "title": "How hard each world pulls",
            "spec": {
              "kind": "bar",
              "orientation": "horizontal",
              "categories": ["Moon", "Mars", "Earth", "Jupiter"],
              "series": [
                {
                  "id": "gravity",
                  "label": "Gravity (Earth = 1)",
                  "values": [0.165, 0.38, 1, 2.53]
                }
              ],
              "valueAxis": {
                "label": "Surface gravity",
                "unit": "× Earth",
                "scale": "linear",
                "domain": [0, 3]
              }
            }
          }
        },
        {
          "id": "mass-callout",
          "type": "callout",
          "data": {
            "kind": "key-idea",
            "title": "Weight is not mass",
            "spans": "Your mass, how much stuff you are made of, is the same on every world. A scale measures the pull on that mass, so only the reading changes."
          }
        }
      ]
    },
    {
      "id": "limits",
      "heading": "What this leaves out",
      "blocks": [
        {
          "id": "limits-callout",
          "type": "callout",
          "data": {
            "kind": "limit",
            "spans": "These readings ignore spin, altitude and the fact that you could not stand on Jupiter at all. They compare pulls, not what a trip would feel like."
          }
        }
      ]
    }
  ],
