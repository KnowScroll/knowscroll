{
  "name": "knowscroll",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "dev:generation": "tsx apps/worker/src/generation/main.ts",
    "maintenance:reasoning": "tsx apps/worker/src/reasoning/maintenance-main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "format": "pnpm format:sql && pnpm format:ts",
    "format:sql": "node scripts/format-query-sql.mjs --write",
    "format:ts": "biome format --write apps/api apps/worker packages tests scripts ops",
    "format:check": "node scripts/format-query-sql.mjs --check && biome format apps/api apps/worker packages tests scripts ops",
    "lint": "biome lint apps/api apps/worker packages && node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "contracts:check": "tsx scripts/export-contracts.ts && git diff --exit-code -- packages/contracts/http-v1.schema.json",
    "knip": "knip",
    "typecheck:web": "pnpm --filter web typecheck",
    "test": "./scripts/test.sh",
    "test:web": "pnpm --filter web test",
    "verify:journey": "tsx scripts/verify-journey.ts",
    "state": "tsx scripts/state.ts"
  },
  "dependencies": {
    "@knowscroll/contracts": "workspace:*",
    "@knowscroll/core": "workspace:*",
    "@knowscroll/db": "workspace:*",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "knip": "6.39.0",
    "sql-formatter": "15.9.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
