{
  "name": "knowscroll",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.23.0 <23"
  },
  "scripts": {
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "dev:generation": "tsx apps/worker/src/generation/main.ts",
    "maintenance:reasoning": "tsx apps/worker/src/reasoning/maintenance-main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "pnpm --filter web typecheck",
    "test": "./scripts/test.sh",
    "test:web": "pnpm --filter web test",
    "verify:journey": "tsx scripts/verify-journey.ts",
    "state": "tsx scripts/state.ts"
  },
  "dependencies": {
    "ai": "7.0.102",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "vercel-minimax-ai-provider": "0.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
