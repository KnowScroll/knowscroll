{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.{js,cjs}"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/migrate.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/worker": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/client": {
      "entry": ["app/**/*.tsx"],
      "project": ["app/**/*.tsx", "features/**/*.{ts,tsx}", "platform/**/*.ts", "theme/**/*.ts"],
      "ignoreDependencies": ["babel-jest"]
    },
    "packages/backend": {
      "project": ["src/**/*.ts"],
      "ignore": ["src/modules/content/adapters/cutroom/wire-v1/**"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "packages/design-tokens": {
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.web.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/client-core": {
      "project": ["src/**/*.ts"]
    },
    "migrations": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["squawk-cli"]
    }
  },
  "ignoreExportsUsedInFile": true
}
