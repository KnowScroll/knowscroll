    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "test-renderer": "catalog:",
    "typescript": "catalog:"
  }
