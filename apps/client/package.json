{
  "name": "@knowscroll/client",
  "version": "0.0.0",
  "private": true,
  "description": "The KnowScroll Expo application for Android, iOS and the web.",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform web --output-dir dist --clear",
    "build:gallery": "EXPO_PUBLIC_KS_GALLERY=1 EXPO_PUBLIC_KS_DEV_EVIDENCE=1 expo export --platform web --output-dir dist-gallery --clear",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --ci",
    "test:web": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "catalog:",
    "@knowscroll/client-core": "workspace:*",
    "@knowscroll/design-tokens": "workspace:*",
    "@knowscroll/scroll-model": "workspace:*",
    "@knowscroll/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "expo": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-font": "catalog:",
    "expo-linking": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-status-bar": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "expo-video": "catalog:",
    "@knowscroll/contracts": "workspace:*",
