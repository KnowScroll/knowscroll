<?xml version="1.0" encoding="utf-8"?>
<!--
  Main manifest. Cleartext traffic is OFF here; only the debug source
  set opts into cleartext for the local emulator loopback. The Kept /
  Source / Keep / Return / Enter Scroll buttons in the app are real
  controls backed by the HTTP contract in docs/contracts/bootstrap-http.md.
  No Ask / Friends / Reel button is declared because they are not part
  of this slice (see scoped AGENTS.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KnowScrollApp"
        android:label="@string/app_label"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.KnowScroll">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_label"
            android:theme="@style/Theme.KnowScroll">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
