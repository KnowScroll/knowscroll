<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest. Merges with the main manifest. Adds a
  network_security_config that allows cleartext HTTP to 10.0.2.2
  (the Android emulator's view of the host loopback) so the app can
  reach the bootstrap HTTP service at http://10.0.2.2:4310. Release
  builds do NOT inherit this — they keep usesCleartextTraffic="false".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
