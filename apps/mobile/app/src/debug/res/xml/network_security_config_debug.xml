<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config. Cleartext is permitted ONLY for
  the Android emulator host loopback (10.0.2.2) and for 127.0.0.1, so
  debug builds can reach the local bootstrap service. Release builds
  do not inherit this; see AndroidManifest.xml in the main source set.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
