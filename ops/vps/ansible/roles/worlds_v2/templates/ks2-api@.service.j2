# KnowScroll v2 API for world %i — managed by ops/vps/ansible (#228). Runs a verified release's
# `api` program as its release.json names it (ks2-run), never source. Installed, not enabled:
# `ks deploy` starts ks2-world@%i.target when it deploys a v2 release to the world.
[Unit]
Description=KnowScroll v2 API (%i)
After=network-online.target postgresql@16-main.service
Wants=network-online.target
PartOf=ks2-world@%i.target
# It listens on the same loopback port as v1's API, so the two never run together.
Conflicts=ks-api@%i.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=ks-%i
Group=ks-%i
Slice=ks-%i.slice
WorkingDirectory=/srv/knowscroll/%i/current
EnvironmentFile=/etc/knowscroll/%i.v2.env
EnvironmentFile=/etc/knowscroll/secrets/v2-%i/database.env
# AGENTMAIL_API_KEY and AGENTMAIL_INBOX_ID for sign-in mail (S1.3, D-007; dev and stage share the
# inbox). Only the API reads it: the worker never receives this key. Production refuses to start
# without it.
EnvironmentFile=/etc/knowscroll/secrets/shared/agentmail.env
# KS_COMMIT and KS_ARTIFACT_SHA256 (the received tarball's sha256), written by ks for /health.
EnvironmentFile=/srv/knowscroll/%i/current/.ks/release.env
Environment=NODE_ENV=production
Environment=KS_WORLD=%i
ExecStart=/usr/local/lib/knowscroll-ops/ks2-run %i api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh={{ ks_v2_services.api.memory_high }}
MemoryMax={{ ks_v2_services.api.memory_max }}

# Sandbox: read-only system, private /tmp, writes only to this world's v2 media.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/srv/knowscroll/%i/media-v2

[Install]
WantedBy=ks2-world@%i.target
