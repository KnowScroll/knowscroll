# KnowScroll — managed by ops/vps/ansible (#201). Edits here are overwritten; change the template.
{% set ks_app_content_security_policy = lookup('ansible.builtin.file', 'app-content-security-policy.txt') | trim %}
# Every name gets HTTPS automatically. APIs listen on 127.0.0.1 only; Caddy is the only door.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(api_proxy) {
	reverse_proxy {args[0]} {
		# Hold requests briefly while a world restarts, so a deploy shows no errors.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

# #228: Socket.IO. Caddy proxies the WebSocket upgrade by itself; a Caddy reload keeps open
# sockets for a while instead of closing them all at once.
(socket_proxy) {
	reverse_proxy {args[0]} {
		lb_try_duration 5s
		lb_try_interval 250ms
		stream_close_delay 5m
	}
}

{% for host in ks_apex_hosts %}{{ host }}{% if not loop.last %}, {% endif %}{% endfor %} {
	import security_headers
	redir https://{{ ks_live_app_host }}{uri} 302
}

# Live: placeholders until the live slice lands.
{{ ks_live_app_host }} {
	import security_headers
	root * /srv/knowscroll/placeholder/web
	file_server
}

{{ ks_live_backend_host }} {
	import security_headers
	header Content-Type application/json
	respond `{"status":"not-deployed","world":"live"}` 503
}

{% for w in ks_worlds %}
# {{ w.name }}
{{ w.app_host }} {
	import security_headers
	# #226 review m7: the v2 web app (an Expo export, recognised by its /_expo folder) runs under
	# a Content-Security-Policy (files/app-content-security-policy.txt, also served by the client's
	# Playwright smoke). v1's web, which still runs on a world until its first v2 deploy, gets only
	# the framing refusal. API answers carry their own headers (apps/api `apiSecurityHeaders`).
	@v2_web file {
		root /srv/knowscroll/{{ w.name }}/current/web
		try_files /_expo/
	}
	# Sockets and media byte ranges pass through unencoded.
	@compressible not path /socket.io/* /media/*
	encode @compressible zstd gzip

	# One origin per world (D-008): the world's API, v1 or v2 on the same port, behind these
	# paths. v1 answers only /v1 and /health; the v2 paths (#228) reach it as a 404.
	@api path /v1/* /health /auth/* /media/* /s/*
	handle @api {
		import api_proxy 127.0.0.1:{{ w.port }}
	}
	handle /socket.io/* {
		import socket_proxy 127.0.0.1:{{ w.port }}
	}
	# Content-hashed bundles: v1's Vite /assets, v2's Expo web export /_expo (#228).
	@immutable path /assets/* /_expo/*
	handle @immutable {
		# Never framed; the v2 app's full policy replaces the framing-only one (review m7). A route
		# block keeps this order (Caddy would otherwise sort the matched header first).
		route {
			header X-Frame-Options DENY
			header Content-Security-Policy "frame-ancestors 'none'"
			header @v2_web Content-Security-Policy "{{ ks_app_content_security_policy | replace('{socket_origin}', 'wss://' ~ w.app_host) }}"
		}
		root * /srv/knowscroll/{{ w.name }}/current/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Everything else is the web app from the current release, whichever generation it is: a file,
	# a statically exported page (Expo's {path}.html), or the single-page fallback.
	handle {
		# Never framed; the v2 app's full policy replaces the framing-only one (review m7). A route
		# block keeps this order (Caddy would otherwise sort the matched header first).
		route {
			header X-Frame-Options DENY
			header Content-Security-Policy "frame-ancestors 'none'"
			header @v2_web Content-Security-Policy "{{ ks_app_content_security_policy | replace('{socket_origin}', 'wss://' ~ w.app_host) }}"
		}
		root * /srv/knowscroll/{{ w.name }}/current/web
		header Cache-Control "no-cache"
		try_files {path} {path}.html /index.html
		file_server
	}
}

{{ w.backend_host }} {
	import security_headers
	encode zstd gzip
	import api_proxy 127.0.0.1:{{ w.port }}
}

{% endfor %}
