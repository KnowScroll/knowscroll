  "brief": {
    "version": 1,
    "worldId": "knowscroll-greenhouse",
    "narration": [
      {
        "text": "Space around our planet is bitterly cold.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "Yet the planet stays far warmer than the space around it.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "Certain gases in the air, called greenhouse gases, trap heat near the ground.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "Sunlight warms the field, and those gases hold much of that warmth close.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "Without carbon dioxide, this greenhouse effect would collapse.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "The ground and the water would grow far colder, by about thirty three degrees.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "It works like a blanket.",
        "claimIds": [
          "c4"
        ]
      },
      {
        "text": "A blanket keeps warmth in, but it does not make the warmth itself.",
        "claimIds": [
          "c4"
        ]
      }
    ],
