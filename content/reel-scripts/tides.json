  "brief": {
    "version": 1,
    "worldId": "knowscroll-tides",
    "narration": [
      {
        "text": "The Moon looks small and far away in the sky.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "It floats pale above a calm blue sea.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "Yet its pull draws the sea toward it.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "The water climbs high up the sandy beach, and that rise is the tide.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "The same invisible pull keeps a stone resting on the grass.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "It is the force that holds you to the ground.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "Far across space, it still tugs at the harbour water.",
        "claimIds": [
          "c4"
        ]
      },
      {
        "text": "The small boats float high on the rising tide.",
        "claimIds": [
          "c4"
        ]
      }
    ],
