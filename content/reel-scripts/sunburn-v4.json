    "worldId": "knowscroll-sunburn-v4",
    "narration": [
      {
        "text": "The Sun bathes the beach in heat, light and invisible ultraviolet light.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "Only the ultraviolet light can burn your skin.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "Ultraviolet light carries more energy than the light you can see.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "Too much of it injures skin cells, and the skin turns red and sore.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "Ultraviolet light bounces off bright, fresh snow.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "A hat and clothing block the rays before they reach you.",
        "claimIds": [
          "c4"
        ]
      },
      {
        "text": "Then you keep the warm, bright day and lose only the burn.",
        "claimIds": [
          "c4"
        ]
      }
    ],
