  "brief": {
    "version": 1,
    "worldId": "knowscroll-seasons",
    "narration": [
      {
        "text": "The planet travels around the Sun, spinning on a tilted axis.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "That tilt, not its distance from the Sun, is what makes the seasons.",
        "claimIds": [
          "c1"
        ]
      },
      {
        "text": "In summer, your side of the planet leans toward the Sun, so its light strikes more directly.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "The light falls on less ground, so each patch warms more.",
        "claimIds": [
          "c2"
        ]
      },
      {
        "text": "Months later, the same side leans away, and sunlight arrives at a slant.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "The same light spreads thinner, so the ground stays cold, and that is winter.",
        "claimIds": [
          "c3"
        ]
      },
      {
        "text": "Twice a year the axis sits sideways to the Sun.",
        "claimIds": [
          "c4"
        ]
      },
      {
        "text": "Then daylight lasts about half the day everywhere, at the equinox.",
        "claimIds": [
          "c4"
        ]
      }
    ],
